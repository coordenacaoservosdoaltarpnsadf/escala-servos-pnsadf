<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Servos do Altar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
    <style>
        /* Centraliza tudo na tela */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-color: #121c24;
            background-image: radial-gradient(circle at center, #1a2632 0%, #11191f 100%);
        }

        /* O container principal do login (o cartão) */
        .login-card {
            width: 100%;
            max-width: 900px;
            padding: 0;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            border: none;
            border-radius: 15px;
            background-color: var(--card-background-color);
        }

        /* Grid para dividir imagem e formulário */
        .login-grid {
            display: grid;
            grid-template-columns: 1fr; /* Mobile: empilhado */
        }

        /* A área da imagem */
        .login-image {
            /* URL ESTÁVEL DA WIKIMEDIA COMMONS (Escultura de São Tarcísio) */
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Saint_Tarcisius_Falgui%C3%A8re_Orsay_RF174_n01.jpg/640px-Saint_Tarcisius_Falgui%C3%A8re_Orsay_RF174_n01.jpg');
            background-size: cover;
            background-position: center;
            min-height: 250px;
            position: relative;
        }

        /* Overlay escuro elegante */
        .login-image::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.6));
        }

        /* A área do formulário */
        .login-form-container {
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .quote-footer {
            margin-top: 2rem;
            text-align: center;
            font-style: italic;
            font-size: 0.85rem;
            opacity: 0.6;
        }

        /* Desktop: Lado a Lado */
        @media (min-width: 768px) {
            .login-grid {
                grid-template-columns: 1.2fr 0.8fr; /* Imagem maior que o form */
                min-height: 600px;
            }
            .login-image {
                min-height: auto;
            }
        }
    </style>
</head>
<body>
    <article class="login-card">
        <div class="login-grid">
            
            <div class="login-image" role="img" aria-label="São Tarcísio"></div>

            <div class="login-form-container">
                <hgroup>
                    <h1>Bem-vindo(a)</h1>
                    <p>Escala dos Servos do Altar</p>
                </hgroup>

                <% if (messages.danger) { %>
                    <div style="background-color: #c62828; color: white; padding: 10px 15px; border-radius: 5px; margin-bottom: 20px; font-size: 0.9rem;">
                        <%= messages.danger %>
                    </div>
                <% } %>
                
                <form method="post" action="/login">
                    <label for="email">E-mail
                        <input type="email" name="email" id="email" placeholder="seu@email.com" required>
                    </label>
                    
                    <label for="password">Senha
                        <input type="password" name="password" id="password" placeholder="••••••••" required>
                    </label>

                    <button type="submit" class="contrast" style="margin-top: 1rem; width: 100%;">Entrar</button>
                </form>

                <div class="quote-footer">
                    <hr style="margin: 1.5rem 0;">
                    "São Tarcísio, mártir da Eucaristia, rogai por nós."
                </div>
            </div>
        </div>
    </article>
</body>
</html>