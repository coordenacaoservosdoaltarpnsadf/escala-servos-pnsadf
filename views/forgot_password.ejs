<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Senha</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
</head>
<body style="display:flex; justify-content:center; align-items:center; height:100vh;">
    <article style="width:100%; max-width:400px;">
        <header><strong>Recuperar Senha</strong></header>
        <% if (messages.danger) { %><div style="color: #ff6b6b; margin-bottom: 10px;"><%= messages.danger %></div><% } %>
        
        <form action="/esqueci-senha" method="post">
            <label>Digite seu e-mail cadastrado:
                <input type="email" name="email" required>
            </label>
            <button type="submit" class="contrast">Enviar Link</button>
        </form>
        <footer><a href="/login">Voltar para Login</a></footer>
    </article>
</body>
</html>