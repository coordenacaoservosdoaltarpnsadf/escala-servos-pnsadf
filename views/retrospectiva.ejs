<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sua Retrospectiva</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
    <style>
        /* Estilo Gradiente Estilo Spotify */
        body {
            background: linear-gradient(135deg, #1db954 0%, #191414 100%);
            min-height: 100vh;
            color: white;
        }
        .retro-card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 2rem;
        }
        .big-number { font-size: 4rem; font-weight: bold; color: #1db954; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
        .stat-label { text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem; opacity: 0.8; }
        .medalha { font-size: 3rem; margin-bottom: 10px; display: block; }
    </style>
</head>
<body>
    <main class="container">
        <nav>
            <ul><li><strong>Servos do Altar</strong></li></ul>
            <ul><li><a href="/" class="contrast">Voltar</a></li></ul>
        </nav>

        <hgroup style="text-align: center; margin-bottom: 3rem;">
            <h1>Sua Jornada no Altar</h1>
            <p>Obrigado pelo seu serviço, <%= user.nome %>!</p>
        </hgroup>

        <div class="grid">
            <div class="retro-card">
                <span class="medalha">⛪</span>
                <div class="big-number"><%= totalMissas %></div>
                <div class="stat-label">Missas Servidas</div>
            </div>

            <div class="retro-card">
                <span class="medalha">⭐</span>
                <div class="big-number" style="font-size: 2rem; padding: 1.5rem 0;"><%= funcaoFavorita %></div>
                <div class="stat-label">Sua Especialidade</div>
            </div>
        </div>

        <div class="retro-card">
            <h3>Histórico Completo</h3>
            <table role="grid">
                <thead><tr><th>Data</th><th>Função</th></tr></thead>
                <tbody>
                    <% historico.forEach(vaga => { %>
                    <tr>
                        <td><%= formatDate(vaga.Missa.data) %></td>
                        <td><%= vaga.funcao %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>